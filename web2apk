module.exports = freewebtoapk
module.exports._internal = { makePng, buildIcons, zipEntries, zipRead, kindOf, saveBinary }

if (require.main === module) {
  const args = process.argv.slice(2)
  const flag = (n) => { const i = args.indexOf(`--${n}`); return i > -1 ? args.splice(i, 2)[1] : undefined }
  const opts = { out: flag('out'), version: flag('ver'), color: flag('color'), format: flag('format') }
  const split = flag('split')
  if (split) {
    // pisah file .bin hasil build sebelumnya tanpa build ulang
    const b = fs.readFileSync(split)
    const files = saveBinary(opts.out || path.dirname(path.resolve(split)), path.basename(split).replace(/\.[^.]+$/, ''), b)
    console.log(JSON.stringify({ status: true, creator: 'Kersio', files, head: files.length === 1 ? headOf(b) : undefined }, null, 2))
    process.exit(0)
  }
  const [name, url] = args
  if (!name || !url) {
    console.log('Pemakaian: node freewebtoapk.js <nama> <https://url> [--out folder] [--ver 1.0.0] [--color #00D4FF] [--format apk|aab]')
    process.exit(1)
  }
  freewebtoapk(name, url, opts).then((r) => console.log(JSON.stringify(r, null, 2)))
}
